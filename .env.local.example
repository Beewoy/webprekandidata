# Lokálny vývoj — skopírujte ako .env.local a doplňte hodnoty z `npm run supabase:env`.
# Produkcia (Vercel) používa cloud Supabase URL a kľúče; na Mac ich neukladajte.

# Supabase (lokálny Docker stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
DEMO_MODE=false
LEGAL_DOCUMENTS_APPROVED=false

# Voliteľné integrácie pre lokálny test (Stripe test mode, OpenAI, Brevo pre kontaktný formulár)
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# AI_AUDIT_HMAC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PLUS=
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
