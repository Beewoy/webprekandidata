# Supabase
# Lokálny vývoj: spustite `npm run supabase:start`, potom `npm run supabase:env`.
# Produkcia: iba vo Vercel Environment Variables (nikdy v .env.local na Macu).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Iba server. Potrebný na vydávanie aplikačných overovacích tokenov.
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Verejný host platformy pre kandidátske URL (bez protokolu), napr. webprekandidata.sk
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Lokálny demo/fallback: true. Produkcia (Vercel): MUSÍ byť explicitne false.
# V NODE_ENV=production demo režim nie je povolený — chýbajúci Supabase nesmie spustiť demo.
DEMO_MODE=true
# Nastavte na true po vlastnej kontrole pracovných právnych dokumentov a SELLER_*.
LEGAL_DOCUMENTS_APPROVED=false
# Náhodná dlhá hodnota pre autorizáciu Vercel Cron retenčnej úlohy.
CRON_SECRET=

# Vercel Domains API — iba server. Potrebné pre Plus vlastnú doménu (DNS/SSL).
# Nikdy NEXT_PUBLIC_. V demo režime alebo bez týchto hodnôt sa Vercel nevolá.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Voliteľné pre tímový účet Vercel.
VERCEL_TEAM_ID=

# Brevo SMTP — používa Supabase Auth aj serverové aplikačné e-maily.
# SMTP key nie je API key ani heslo do Brevo.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# AI onboarding — iba server. Model je možné zmeniť bez úpravy kódu.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Samostatný náhodný secret na pseudonymizovaný HMAC fingerprint AI požiadaviek.
AI_AUDIT_HMAC_KEY=

# Stripe Checkout — iba server. Nikdy NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PLUS=

# Fakturačný snapshot predávajúceho (SZČO). Predvolené hodnoty sú v kóde; env ich prepíše.
SELLER_NAME=Ing. Tibor Antal
SELLER_ADDRESS=Jána Stanislava 3085/37, 841 05 Bratislava - Karlova Ves, Slovensko
SELLER_ICO=50640259
SELLER_DIC=1075966881
SELLER_EMAIL=ahoj@beewoy.sk
SELLER_PHONE=+421 948 473 255
SELLER_REGISTER=Živnostenský register Slovenskej republiky
SELLER_REGISTRATION_AUTHORITY=Okresný úrad Bratislava
SELLER_REGISTRATION_NUMBER=110-253321
SELLER_VAT_PAYER=false
# SELLER_IC_DPH=
SELLER_SUPERVISORY_NAME=Slovenská obchodná inšpekcia — Ústredný inšpektorát
SELLER_SUPERVISORY_ADDRESS=Bajkalská 21/A, P. O. BOX 29, 827 99 Bratislava
SELLER_SUPERVISORY_EMAIL=podnety@soi.sk
SELLER_ARS_EMAIL=ars@soi.sk

# Sentry monitoring. DSN je verejný identifikátor; auth token je iba pre CI/source map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
