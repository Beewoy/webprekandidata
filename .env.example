# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Iba server. Potrebný na vydávanie aplikačných overovacích tokenov.
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Nastavte na false až po pripojení a aplikovaní migrácií v Supabase.
DEMO_MODE=true

# Brevo SMTP — používa Supabase Auth aj serverové aplikačné e-maily.
# SMTP key nie je API key ani heslo do Brevo.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# AI onboarding — iba server. Model je možné zmeniť bez úpravy kódu.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Samostatný náhodný secret na pseudonymizovaný HMAC fingerprint AI požiadaviek.
AI_AUDIT_HMAC_KEY=

# Integrations - doplnia sa v neskorších fázach
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
